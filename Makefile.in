# Generated by ./configure — do not edit directly, edit Makefile.in
# and re-run ./configure instead.
#
# Written to be portable across GNU make and BSD/POSIX make: no
# ifeq/ifdef, no :=, no $(shell ...), no % pattern rules, no += —
# every value below was already resolved to a literal by configure
# itself, EXCEPT PYTHON/PIP/PYTEST, which stay overridable (?=) on
# purpose. By default they point at the venv ./configure created (see
# VENV_PATH below); overriding them targets any other interpreter,
# for example a CI or distribution-provided environment:
#
#     make check PYTHON=/path/to/python PIP="/path/to/python -m pip" \
#                PYTEST=/path/to/pytest
#
# Follows the GNU Coding Standards' "Makefile Conventions"
# (https://www.gnu.org/prep/standards/html_node/Makefile-Conventions.html)
# where they apply to a pip/meson-python-installed Python package.
# It deliberately diverges in two places (no --libdir/--bindir
# behavior: pip already owns venv binary/library placement; no VPATH
# out-of-tree build support, since every value here is a literal
# already resolved by configure, not a build-tree-relative path).

PYTHON       ?= @VENV_PYTHON@
PIP          ?= @VENV_PIP@
PYTEST       ?= @VENV_PYTEST@
VENV_PATH    = @VENV_PATH@
PREFIX       = @PREFIX@
DOCDIR       = @DOCDIR@
CC           ?= cc
CXX          ?= c++

.PHONY: all help build install install-docs install-html install-strip installcheck \
        installdirs uninstall test check test-native docs clean \
        mostlyclean distclean maintainer-clean dist TAGS report

# GNU Coding Standards: "the first rule in the makefile should be the
# one for `all`... this should be the default target."
all: build

help:
	@echo "paulikit Makefile (generated by ./configure)"
	@echo ""
	@echo "  make               - alias for 'make all' (= 'make build')"
	@echo "  make build         - editable install into the venv (pip install -e .[dev], native-build-safe)"
	@echo "  make install       - alias for build"
	@echo "  make install-docs  - editable install with docs extras (pip install -e .[docs])"
	@echo "  make install-strip - alias for install (no compiled binaries to strip)"
	@echo "  make installdirs   - create \$$(PREFIX) and \$$(DOCDIR) if they don't exist"
	@echo "  make check         - alias for test"
	@echo "  make test          - run the pytest suite (build first)"
	@echo "  make test-native   - build and run the standalone C/C++ kernel checks (no Python binding)"
	@echo "  make installcheck  - run the test suite against the installed package, not the source tree"
	@echo "  make uninstall     - pip uninstall paulikit from the venv"
	@echo "  make docs          - build Sphinx HTML docs into docs/_build/html (delegates to docs/Makefile)"
	@echo "  make install-html  - copy the built HTML docs into \$$(DOCDIR) (may need root)"
	@echo "  make dist          - build an sdist + wheel into dist/ (python -m build)"
	@echo "  make TAGS          - generate a TAGS file for src/ (requires ctags or etags)"
	@echo "  make clean         - remove build/test artifacts (including docs/_build)"
	@echo "  make mostlyclean   - like clean, but keep the compiled native extension"
	@echo "  make distclean     - clean, plus remove this package's own venv (@VENV_PATH@) and Makefile"
	@echo "  make maintainer-clean - distclean, plus remove dist/ and any generated docs output"
	@echo "  make report        - reprint configure's diagnostic report (config.log)"
	@echo ""
	@echo "Override PYTHON/PIP/PYTEST to target a different interpreter or"
	@echo "venv, e.g. make check PYTHON=/path/to/python."
	@echo ""
	@echo "PREFIX=$(PREFIX) DOCDIR=$(DOCDIR)"
	@echo "(--bindir/--libdir/--sysconfdir/--mandir/--infodir/etc. are accepted"
	@echo "by ./configure for GNU-convention compatibility but are not"
	@echo "applicable to this package: pip owns all binary/library placement"
	@echo "inside the venv. See config.log for what was recorded.)"

# meson-python's editable install re-runs `ninja` every time
# `import paulikit` happens (not just at install time), to pick up
# source changes live. That rebuild-on-import subprocess needs
# cython/ninja/meson AND numpy's build-time headers all resolvable
# from the venv itself, permanently — not from pip's default build
# isolation, which creates a throwaway venv-of-a-venv, records ITS
# numpy include path into build.ninja, then deletes that throwaway
# env right after install. Every subsequent rebuild-on-import then
# fails with "numpy/arrayobject.h: No such file or directory" because
# the recorded path no longer exists. Fix: pre-install
# numpy/cython/meson/ninja into the real venv first, then install
# paulikit with --no-build-isolation so the paths meson records are
# this venv's own, permanent ones. PATH is prepended with the venv's
# own bin/ for the second step too: meson's compiler-detection
# subprocess looks up cython/cython3 via a bare PATH search, and pip
# does not activate the venv on our behalf just because
# --no-build-isolation was passed.
build:
	$(PIP) install numpy meson-python cython ninja
	PATH="$(VENV_PATH)/bin:$$PATH" $(PIP) install --no-build-isolation -e ".[dev]"

install: build

# No compiled binaries land outside the venv's own site-packages (the
# native extension is a .so inside the package itself, already
# stripped by the release build's -DNDEBUG/-O3 defaults) — nothing
# further to strip, so this is a plain alias, kept for GCS compliance
# (a real GNU package's `install-strip` target is expected to exist).
install-strip: install

# --no-build-isolation and the venv PATH prefix for the same reasons
# `build` needs them: a bare `pip install -e .` resolves NumPy from an
# ephemeral build-isolation environment and bakes that (now-deleted)
# include path into the meson-python editable rebuild hook, so the
# next rebuild fails with "numpy/arrayobject.h: No such file or
# directory". Depending on `build` first also guarantees the compiled
# extension exists before Sphinx imports the package to autodoc it.
install-docs: build
	PATH="$(VENV_PATH)/bin:$$PATH" $(PIP) install --no-build-isolation -e ".[docs]"

installdirs:
	mkdir -p "$(PREFIX)"
	mkdir -p "$(DOCDIR)"

uninstall:
	$(PIP) uninstall -y paulikit

check: test

test: build
	PATH="$(VENV_PATH)/bin:$$PATH" $(PYTEST)

# GCS's "installcheck" tests the package as actually installed, not
# just that the source tree happens to be importable — confirm the
# import resolves through the venv's own site-packages/editable-
# finder machinery, then run the real test suite (paulikit's tests
# live in tests/, outside the package itself, so --pyargs paulikit
# would collect zero tests: it only discovers tests importable as
# part of the package).
installcheck: install
	PATH="$(VENV_PATH)/bin:$$PATH" $(PYTHON) -c \
		"import paulikit, sys; print('paulikit', paulikit.__file__)"
	PATH="$(VENV_PATH)/bin:$$PATH" $(PYTEST)

test-native:
	$(CC) -std=c99 -Wall -Wextra -Werror -o /tmp/paulikit_test_pauli_label \
		src/paulikit/_native/pauli_label.c \
		src/paulikit/_native/test_pauli_label.c
	/tmp/paulikit_test_pauli_label
	$(CXX) -std=c++17 -O2 -Wall -Wextra -Werror -o /tmp/paulikit_test_pauli_label_parallel \
		src/paulikit/_native/pauli_label.c \
		src/paulikit/_native/pauli_label_parallel.cpp \
		src/paulikit/_native/test_pauli_label_parallel.cpp -ltbb
	/tmp/paulikit_test_pauli_label_parallel

# Builds the HTML into docs/_build/html and stops there. Copying into
# DOCDIR is deliberately NOT done here: DOCDIR defaults under PREFIX
# (/usr/local), so depending on `installdirs` made a plain `make docs`
# fail with a permission error for any non-root user - a build target
# must not require root. `make install-html` does the copy, following
# the GNU Coding Standards' own separation of build from install.
docs: install-docs
	$(MAKE) -C docs html SPHINXBUILD="$(PYTHON) -m sphinx"

install-html: docs installdirs
	mkdir -p "$(DOCDIR)"
	cp -r docs/_build/html/. "$(DOCDIR)/"

dist:
	$(PYTHON) -m build

TAGS:
	@if command -v ctags >/dev/null 2>&1; then \
		ctags -R -e -o TAGS src/; \
	elif command -v etags >/dev/null 2>&1; then \
		find src -name '*.py' -o -name '*.pyx' -o -name '*.c' -o -name '*.cpp' | xargs etags -o TAGS; \
	else \
		echo "TAGS: neither ctags nor etags found, skipping" >&2; \
	fi

# GCS: a clean target must not fail. Removing docs output is guarded
# on docs/Makefile existing, so `make clean` works in a tree where the
# documentation has not been built - or is not present at all - rather
# than aborting and taking distclean and maintainer-clean with it.
clean:
	rm -rf build .pytest_cache src/paulikit.egg-info
	find . -type d -name __pycache__ -exec rm -rf {} + 2>/dev/null || true
	find . -type f -name '*.pyc' -delete 2>/dev/null || true
	@if [ -f docs/Makefile ]; then $(MAKE) -C docs clean; else \
		rm -rf docs/_build; fi

# GCS: mostlyclean should leave alone the things "we are likely to
# want to rebuild" — here, the compiled native extension under
# build/, which is genuinely expensive to recompile (Cython + C++ +
# TBB link), unlike the cheap-to-regenerate cache/egg-info clutter.
mostlyclean:
	rm -rf .pytest_cache src/paulikit.egg-info
	find . -type d -name __pycache__ -exec rm -rf {} + 2>/dev/null || true
	find . -type f -name '*.pyc' -delete 2>/dev/null || true

# GCS: distclean deletes everything configure created, so that what
# remains is exactly what came from the distribution. That is all
# three of configure's outputs - Makefile, config.log and
# config.status - plus the venv it provisioned.
distclean: clean
	rm -rf $(VENV_PATH)
	rm -f Makefile config.log config.status

maintainer-clean: distclean
	rm -rf dist TAGS

report:
	@cat config.log

# GCS: "The rule for `Makefile` itself should also depend on all of
# the source files from which it is constructed" — re-run configure
# automatically if Makefile.in or configure itself changed since the
# Makefile was generated.
Makefile: Makefile.in configure
	./configure
